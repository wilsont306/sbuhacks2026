{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/host", "destination": "/host.html" },
    { "source": "/", "destination": "/join.html" }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/host", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(host|join).html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
