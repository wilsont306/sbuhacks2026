# Copy to .env (never commit .env). tools/start.cmd loads it; the local hub inherits these values.
# Hub the kiosk opens (default Fly); start.cmd opens %HUB_URL%/host?host=%HOST_TOKEN%
HUB_URL=https://toy-theatre-hub.fly.dev
# Host token, letters and digits only; must match the Fly secret so Q can switch hubs with the same token
HOST_TOKEN=change-me
# What the QR encodes; set on Fly to the Vercel production URL, leave empty locally to get http://<LAN_IP>/
JOIN_URL=
# Hotspot credentials for the Wi-Fi QR in the Q fallback; leave empty to hide it
WIFI_SSID=
WIFI_PASS=
# Laptop LAN address for the fallback QR; empty = auto-detect the first private IPv4
LAN_IP=
# CORS origin for /healthz, e.g. https://<project>.vercel.app; empty = *
ALLOW_ORIGIN=
