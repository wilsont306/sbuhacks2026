# Copy to .env (never commit .env). tools/start.cmd loads it; the laptop hub (the Q fallback) inherits these values.
# Local-fallback values only. Keep every comment at the start of its line: start.cmd skips lines that begin with #.
# Never point `vercel env pull` at this file: Vercel's JOIN_URL here would send the fallback QR to Vercel.
# Where the kiosk loads the host page: this laptop, or the Vercel production URL (Q then switches to this laptop's hub)
HUB_URL=http://localhost
# Host token, letters and digits only; empty = no check (local only). Use the Vercel value: the host page sends one token to both relays
HOST_TOKEN=change-me
# What the fallback QR encodes; leave empty to get http://<LAN_IP>/ (phones on the hotspot need the laptop, not Vercel)
JOIN_URL=
# Hotspot credentials for the Wi-Fi QR in the Q fallback; leave empty to hide it
WIFI_SSID=
WIFI_PASS=
# Laptop LAN address for the fallback QR; empty = auto-detect the first private IPv4
LAN_IP=
# CORS origin for /healthz, e.g. https://<project>.vercel.app; empty = *
ALLOW_ORIGIN=

# tools/sfx.mjs (run once, offline) also reads ELEVENLABS_API_KEY from .env; add that line to .env only, never here.
# Vercel environment variables, set in Project Settings (README "Env"). Names only; values never go in this file.
# HOST_TOKEN, JOIN_URL
# REDIS_URL (or KV_URL / UPSTASH_KV_URL as injected by Upstash; a rediss:// URL)
# BLOB_READ_WRITE_TOKEN (injected by Vercel Blob)
# GEMINI_API_KEY, GEMINI_MODEL (optional), INTERPRET_MAX_PER_HOUR and INTERPRET_MIN_GAP_MS (optional guards)
# ELEVENLABS_API_KEY, SOUND_GEN (on or off), SFX_MAX_PER_HOUR (optional)
# SNOWFLAKE_ACCOUNT, SNOWFLAKE_USER, SNOWFLAKE_PRIVATE_KEY (full PEM, PKCS#8, unencrypted)
# SNOWFLAKE_WAREHOUSE, SNOWFLAKE_DATABASE, SNOWFLAKE_SCHEMA, SNOWFLAKE_ROLE
