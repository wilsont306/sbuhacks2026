#!/bin/sh
# Secret gate: blocks a commit that stages a .env file (except .env.example) or adds a likely secret:
# a secret key set to a value, a Redis URL with a password in it, or a key, token or PEM private key.
# Enable once per clone: git config core.hooksPath .githooks
set -f # the patterns and paths below must never glob
nl='
'
# A key's value, and a Redis URL's password, must start with a letter or digit and not be a placeholder,
# so the empty lines and HOST_TOKEN=change-me in .env.example, and doc placeholders (=…, =<token>, =$VAR,
# =%VAR%, rediss://default:…@host), pass. KV_URL also covers names ending in it.
names='HOST_TOKEN|GEMINI_API_KEY|SNOWFLAKE_PASSWORD|SNOWFLAKE_PRIVATE_KEY|SNOWFLAKE_PAT|ELEVENLABS_API_KEY|TRIPO_API_KEY|REDIS_URL|KV_URL|UPSTASH_KV_URL|BLOB_READ_WRITE_TOKEN'
keys="($names)=[\"']?"
redis='rediss?://[^ :]*:'
placeholder='(change-?me|your[-_])'
keylist=$(printf '%s\n' "$names" | sed 's/|/, /g')
# Secrets wherever they appear: Google (Gemini) key, sk- key, ElevenLabs sk_ key, Tripo tsk_ key, Vercel Blob token,
# PEM private key. The test fakes put a dot early on (tsk_FAKE.…), so they pass.
pats='AIza[0-9A-Za-z_-]{35}
sk-[A-Za-z0-9]{20,}
sk_[0-9a-f]{32,}
tsk_[A-Za-z0-9_-]{20,}
vercel_blob_rw_[A-Za-z0-9_]+
-----BEGIN [A-Z ]*PRIVATE KEY-----'
status=0
files=$(git diff --cached --name-only --diff-filter=ACMR)
IFS=$nl
for f in $files; do
  case "/$f" in
    */.env.example) ;;
    */.env|*/.env.*) echo "pre-commit: $f is a .env file; keep it local and commit .env.example instead" >&2; status=1; continue ;;
  esac
  added=$(git diff --cached -U0 --no-color --no-ext-diff -- "$f" | grep -E '^\+' | grep -vE '^\+\+\+ (b/|/dev/null)')
  [ -n "$added" ] || continue
  if printf '%s\n' "$added" | grep -E -e "${keys}[A-Za-z0-9]" | grep -qvE -e "${keys}${placeholder}"; then
    echo "pre-commit: $f sets one of $keylist to a value" >&2
    status=1
  fi
  if printf '%s\n' "$added" | grep -E -e "${redis}[A-Za-z0-9][^@ ]*@" | grep -qvE -e "${redis}${placeholder}"; then
    echo "pre-commit: $f adds a Redis URL with a password (redis[s]://user:password@host)" >&2
    status=1
  fi
  for p in $pats; do
    if printf '%s\n' "$added" | grep -qE -e "$p"; then
      echo "pre-commit: $f adds a line matching /$p/" >&2
      status=1
    fi
  done
done
[ "$status" -eq 0 ] || echo "pre-commit: commit blocked; remove the secret (or unstage the file) and commit again" >&2
exit "$status"
